/* Structured input assistance */
"This value is too long for a format check. It will be kept." = "Dieser Wert ist für die Formatprüfung zu lang. Er bleibt erhalten.";
"Format matches. Existence and validity are not checked." = "Das Format stimmt. Existenz und Gültigkeit wurden nicht geprüft.";
"Check the email address: name@example.com." = "E-Mail-Adresse prüfen: name@example.com.";
"This email format is not checked. The address will be kept." = "Dieses E-Mail-Format wird nicht geprüft. Die Adresse bleibt erhalten.";
"Check the URL, including its scheme, such as https://." = "URL einschließlich Schema prüfen, zum Beispiel https://.";
"The URL scheme is recognized syntactically. Service-specific rules are not checked." = "Das URL-Schema ist syntaktisch erkennbar. Dienstspezifische Regeln wurden nicht geprüft.";
"Check the card number length, digits, and check digit." = "Länge, Ziffern und Prüfziffer der Kartennummer prüfen.";
"This card brand may use different check-digit rules. Confirm the number with the issuer." = "Diese Kartenmarke kann andere Prüfzifferregeln verwenden. Nummer mit dem Herausgeber abgleichen.";
"Card check digit matches. Card validity and issuer are not checked." = "Die Kartenprüfziffer stimmt. Gültigkeit und Herausgeber wurden nicht geprüft.";
"Security codes usually contain three digits; American Express uses four." = "Sicherheitscodes haben meist drei Ziffern; American Express verwendet vier.";
"Check the IBAN letters, digits, and check digits." = "Buchstaben, Ziffern und Prüfziffern der IBAN prüfen.";
"IBAN check digits match. National format and account existence are not checked." = "Die IBAN-Prüfziffern stimmen. Nationales Format und Existenz des Kontos wurden nicht geprüft.";
"BIC uses eight or eleven letters and digits, with a two-letter country code." = "Ein BIC hat acht oder elf Buchstaben und Ziffern, darunter einen Ländercode mit zwei Buchstaben.";
"Enter a server port from 1 to 65535." = "Serverport zwischen 1 und 65535 eingeben.";
"Modern VINs use 17 letters and digits without I, O, or Q. Older or local chassis numbers may differ." = "Moderne VINs haben 17 Buchstaben und Ziffern ohne I, O oder Q. Ältere oder lokale Fahrgestellnummern können abweichen.";
"VIN format matches. Regional check digits and vehicle existence are not checked." = "Das VIN-Format stimmt. Regionale Prüfziffern und Existenz des Fahrzeugs wurden nicht geprüft.";
"Check the ninth VIN character for a US-registered vehicle." = "Bei einem in den USA zugelassenen Fahrzeug das neunte VIN-Zeichen prüfen.";
"Check the Base32 secret: letters A–Z and digits 2–7." = "Base32-Schlüssel prüfen: Buchstaben A–Z und Ziffern 2–7.";
"Enter the secret key here, rather than the whole otpauth URL." = "Hier den geheimen Schlüssel eingeben, nicht die vollständige otpauth-URL.";
